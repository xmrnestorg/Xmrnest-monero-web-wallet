# XmrNest server secrets. Never commit or copy this file into the browser bundle.

# Swap page: the gateway this wallet forwards swap requests to (docs/swap-gateway-api.md).
# Empty URL = the swap page is hidden. The key is an instance key issued by the gateway; it
# identifies this server (never a user) and never reaches the browser. XmrNest's gateway:
SWAP_GATEWAY_URL=
SWAP_GATEWAY_KEY=

# Redis password (recommended on any shared host). Leave empty for no auth. Changing it needs
# `docker compose up -d` for both wallet-redis and node-wallet-api.
REDIS_PASSWORD=

# Operator token for the detailed /api/health?token=... view (empty = summary only).
HEALTH_TOKEN=

# New-wallet protection WITHOUT IP tracking: the browser solves a small puzzle per NEW wallet
# (existing wallets never see it). Difficulty rises by 1 bit per POW_STEP_WALLETS new wallets
# in the last hour, up to POW_MAX_EXTRA_BITS. NEW_WALLETS_PER_DAY is only a last-resort bound.
POW_BASE_BITS=16
POW_STEP_WALLETS=40
POW_MAX_EXTRA_BITS=6
NEW_WALLETS_PER_DAY=5000
# wallet-rpc instances reserved for long restore scans (0 = a quarter of the pool).
# Server (12-instance pool): SCAN_LANES=6
SCAN_LANES=0

